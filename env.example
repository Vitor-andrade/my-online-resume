# Copy to .env.local and fill in. Every variable is optional — the
# site builds and runs without them; the related feature simply stays
# inactive until its key is provided.

# Email delivery for the contact form — https://resend.com (free tier).
# Without a custom domain, Resend sends from onboarding@resend.dev to
# your own account email, which is enough for a contact form.
RESEND_API_KEY=
CONTACT_TO_EMAIL=vitor.andradecavalcante@gmail.com

# Cloudflare Turnstile anti-spam — https://dash.cloudflare.com (free).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog product analytics — https://posthog.com (free tier).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GitHub token for the Projects section's pinned repositories.
# A personal access token with public repository read access
# (https://github.com/settings/tokens). Without it, only the curated
# projects are shown.
GITHUB_TOKEN=

# Public site URL — used for absolute Open Graph / metadata URLs.
NEXT_PUBLIC_SITE_URL=https://vitor-cavalcante.vercel.app/
